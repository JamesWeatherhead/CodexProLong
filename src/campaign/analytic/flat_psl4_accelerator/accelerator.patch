+ActiveLagTable BuildActiveLagTable() {
+  constexpr std::array<uint8_t, 34> kLagPriority = {
+      4,  5,  9,  17, 23, 1,  3,  19, 11, 14, 15, 13,
+      8,  10, 29, 7,  18, 16, 2,  22, 20, 25, 12, 32,
+      6,  33, 24, 26, 34, 27, 30, 21, 31, 28,
+  };
+  ActiveLagTable table;
+  for (int depth = 1; depth <= kHalf; ++depth) {
+    std::array<uint8_t, kSize> seen{};
+    for (int lag : kLagPriority) {
+      if (kBoundTemplates[depth][lag].gap_group_count != 0) {
+        table.lags[depth][table.counts[depth]++] =
+            static_cast<uint8_t>(lag);
+        seen[lag] = 1;
+      }
+    }
+    for (int lag = 1; lag < kSize; ++lag) {
+      if (kBoundTemplates[depth][lag].gap_group_count != 0 && !seen[lag]) {
+        throw std::runtime_error("active-lag priority is incomplete");
+      }
+    }
+  }
+  return table;
+}
+
+const auto kActiveLags = BuildActiveLagTable();
+
+CheapLagTable BuildCheapLagTable() {
+  CheapLagTable table;
+  for (int depth = 1; depth <= kHalf; ++depth) {
+    // The fully determined lags >= N-depth were checked by Extend when their
+    // final edge was assigned.  Among the rest, a violation is structurally
+    // impossible unless the fixed-edge count exceeds bound + free edges.
+    for (int lag = kSize - depth - 1; lag >= 1; --lag) {
+      const BoundTemplate& entry = kBoundTemplates[depth][lag];
+      const int remaining =
+          (kSize - lag) - entry.fixed_edge_count;
+      if (entry.fixed_edge_count > kBound + remaining) {
+        table.lags[depth][table.counts[depth]++] =
+            static_cast<uint8_t>(lag);
+      }
+    }
+  }
+  return table;
+}
+
+const auto kCheapLags = BuildCheapLagTable();
